# Copy to .env (never commit real keys).
# Default provider: Anthropic.
ANTHROPIC_API_KEY=
# Optional overrides
QUILL_MODEL=claude-sonnet-5-5
# OpenAI-compatible alternative (Ollama, OpenRouter, Groq...). Used when set and ANTHROPIC_API_KEY is empty.
QUILL_OPENAI_BASE_URL=
QUILL_OPENAI_API_KEY=
# Context budget (tokens). Compaction triggers at 800f this.
QUILL_CONTEXT_TOKENS=150000
